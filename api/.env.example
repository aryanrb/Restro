PORT=8080
RUNTIME_ENV=dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restro?sslmode=disable

# Browser origins allowed to call the API (comma-separated). Auth uses cookies,
# so this must be an explicit list, never "*". Set to the deployed web URL(s) in prod.
CORS_ORIGINS=http://localhost:5173
# Set to "none" when the web app is on another site (e.g. Vercel → Render): cookies become SameSite=None; Secure (HTTPS only).
# COOKIE_SAMESITE=none

# For DB integration tests (go test). Point at a throwaway database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/restro?sslmode=disable

# Optional: bootstrap the first owner on boot when the DB has no users yet.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
SEED_OWNER_PIN=0000

# Optional: Web Push for alert notifications (VAPID). Leave the keys empty to keep
# push off (alerts still show in the app). Generate a key pair once, e.g.
#   npx web-push generate-vapid-keys
# and keep the private key secret. VAPID_SUBJECT is a contact for push services
# (mailto:you@example.com or an https URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
