PORT=8080
RUNTIME_ENV=dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restro?sslmode=disable

# For DB integration tests (go test). Point at a throwaway database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/restro?sslmode=disable

# Optional: bootstrap the first owner on boot when the DB has no users yet.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
SEED_OWNER_PIN=0000
